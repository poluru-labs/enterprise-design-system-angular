{
  "name": "@poluru-labs/enterprise-design-system-angular",
  "version": "1.0.0",
  "description": "Enterprise Design Systems — Angular component library with design tokens, Storybook, and unit tests.",
  "author": {
    "name": "Subrahmanyam Poluru",
    "email": "subrahmanyam@polurulabs.com",
    "url": "https://github.com/subrahmanyampoluru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poluru-labs/enterprise-design-system-angular.git"
  },
  "homepage": "https://github.com/poluru-labs/enterprise-design-system-angular",
  "bugs": {
    "url": "https://github.com/poluru-labs/enterprise-design-system-angular/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json && node scripts/postbuild-package.mjs",
    "storybook": "ng run enterprise-design-system-angular:storybook",
    "build-storybook": "ng run enterprise-design-system-angular:build-storybook",
    "test": "jest --config jest.config.cjs --watchman=false",
    "test:watch": "jest --config jest.config.cjs --watch --watchman=false",
    "test:coverage": "jest --config jest.config.cjs --coverage --watchman=false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist storybook-static coverage .angular out-tsc",
    "pack:lib": "npm run build && npm pack ./dist",
    "publish:lib": "npm run build && npm publish ./dist --access public"
  },
  "peerDependencies": {
    "@angular/common": "^19.0.0 || ^20.0.0 || ^21.0.0",
    "@angular/core": "^19.0.0 || ^20.0.0 || ^21.0.0",
    "@angular/platform-browser": "^19.0.0 || ^20.0.0 || ^21.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/animations": "^19.2.14",
    "@angular/cli": "^19.2.15",
    "@angular/common": "^19.2.14",
    "@angular/compiler": "^19.2.14",
    "@angular/compiler-cli": "^19.2.14",
    "@angular/core": "^19.2.14",
    "@angular/forms": "^19.2.14",
    "@angular/platform-browser": "^19.2.14",
    "@angular/platform-browser-dynamic": "^19.2.14",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/angular": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/theming": "^8.6.14",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.5.5",
    "ng-packagr": "^19.2.2",
    "rxjs": "^7.8.2",
    "storybook": "^8.6.14",
    "typescript": "~5.8.3",
    "zone.js": "^0.15.1"
  },
  "keywords": [
    "design-system",
    "angular",
    "typescript",
    "storybook",
    "enterprise",
    "tokens"
  ],
  "engines": {
    "node": ">=20"
  }
}
